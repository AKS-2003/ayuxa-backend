# ─── Database (Supabase Postgres — shared with medico) ───
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connect_timeout=30"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ─── JWT ───
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── Server ───
PORT=5000
NODE_ENV=development
BACKEND_PUBLIC_URL="http://localhost:5000"

# ─── CORS allowlist ───
ADMIN_FRONTEND_URL="http://localhost:3000"
BUDDY_APP_URL=""
CONNECT_APP_URL=""

# ─── OTP delivery ───
# console (default, logs OTP instead of sending) | fast2sms
OTP_SMS_PROVIDER="console"
# FAST2SMS_API_KEY=""
# FAST2SMS_BASE_URL="https://www.fast2sms.com/dev/bulkV2"
# FAST2SMS_DLT_ENTITY_ID=""
# FAST2SMS_SENDER_ID="AYUXA"
# FAST2SMS_OTP_TEMPLATE_ID=""

# console (default, logs OTP instead of sending) | zeptomail
OTP_EMAIL_PROVIDER="console"
# ZEPTOMAIL_API_KEY=""
# ZEPTOMAIL_SENDER_EMAIL="noreply@ayuxacare.com"
# ZEPTOMAIL_SENDER_NAME="Ayuxa Care"

# ─── File storage ───
# local (saves to ./uploads, dev-only fallback) | gcs (production — same
# ayuxa-assets bucket medico uses, under an ayuxa/ path prefix)
STORAGE_PROVIDER="gcs"
GOOGLE_STORAGE_BUCKET_NAME="ayuxa-assets"
# GOOGLE_APPLICATION_CREDENTIALS="" # path to a GCS/Firebase service-account JSON key
# ASSETS_CDN_URL="" # optional — leave unset to serve direct storage.googleapis.com URLs
