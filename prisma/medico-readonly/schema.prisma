generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/medico-readonly-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model activity_updates {
  id            String      @id
  lab_order_id  String?
  eventType     String
  serviceType   String
  staffName     String
  staffId       String
  staffPhone    String
  staffPhotoUrl String?
  eta           String?
  statusDetail  String?
  createdAt     DateTime    @default(now())
  lab_orders    lab_orders? @relation(fields: [lab_order_id], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model addresses {
  id           String   @id
  userId       String
  label        String   @default("Home")
  line1        String
  line2        String?
  cityName     String
  state        String
  pincode      String
  landmark     String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  addressLine1 String?
  addressLine2 String?
  city         String?
  country      String   @default("India")
  fullName     String?
  phone        String?
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model admin_sessions {
  id           String   @id
  adminId      String
  deviceId     String?
  deviceType   String   @default("PC")
  browser      String?
  os           String?
  ipAddress    String?
  city         String?
  state        String?  @default("Delhi")
  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  admins       admins   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, isActive])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model admins {
  id                        String                      @id
  name                      String
  email                     String                      @unique
  phone                     String?
  passwordHash              String
  role                      AdminRole                   @default(CITY_ADMIN)
  cityId                    String?
  isActive                  Boolean                     @default(true)
  lastLoginAt               DateTime?
  refreshToken              String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  documentsJson             Json?
  profileImageUrl           String?
  isStaffProfile            Boolean                     @default(false)
  admin_sessions            admin_sessions[]
  cities                    cities?                     @relation(fields: [cityId], references: [id])
  audit_logs                audit_logs[]
  medical_tourism_enquiries medical_tourism_enquiries[]

  @@index([name, email, role, isActive])
}

model app_message_dismissals {
  id                 String       @id
  user_id            String
  app_message_id     String
  message_version    String       @db.VarChar(20)
  status             String       @default("VIEWED") @db.VarChar(20)
  first_dismissed_at DateTime     @default(now())
  updated_at         DateTime
  app_messages       app_messages @relation(fields: [app_message_id], references: [id], onDelete: Cascade)
  users              users        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, app_message_id, message_version], map: "app_message_dismissals_user_id_app_message_id_message_ver_key")
}

model app_messages {
  id                     String                   @id
  title                  String                   @db.VarChar(80)
  body                   String
  type                   String                   @default("ANNOUNCEMENT") @db.VarChar(20)
  isActive               Boolean                  @default(false)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  requiresAgreement      Boolean                  @default(false)
  version                String                   @default("1") @db.VarChar(20)
  imageUrl               String?
  target_city_id         String?
  starts_at              DateTime?
  ends_at                DateTime?
  app_message_dismissals app_message_dismissals[]
  cities                 cities?                  @relation(fields: [target_city_id], references: [id])

  @@index([isActive])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id        String   @id
  adminId   String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  admins    admins?  @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entity, entityId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model banners {
  id         String   @id
  imageUrl   String
  heading    String   @db.VarChar(60)
  subheading String   @db.VarChar(80)
  ctaText    String?  @db.VarChar(30)
  ctaRoute   String?  @db.VarChar(100)
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  category   String   @default("HOME") @db.VarChar(20)

  @@index([isActive, order])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bookings {
  id                        String                     @id
  bookingCode               String                     @unique
  userId                    String
  serviceId                 String
  cityId                    String
  caregiverId               String?
  scheduledDate             DateTime
  scheduledTime             String?
  addressLine               String?
  latitude                  Float?
  longitude                 Float?
  symptoms                  String[]
  doctorType                String?
  prescriptionUrl           String?
  staffType                 String?
  shiftDuration             ShiftDuration?
  startDate                 DateTime?
  endDate                   DateTime?
  requirements              String[]
  pickupAddress             String?
  dropAddress               String?
  vehicleType               String?
  amount                    Float                      @default(0)
  status                    BookingStatus              @default(PENDING)
  adminNotes                String?
  isEscalated               Boolean                    @default(false)
  isSLABreached             Boolean                    @default(false)
  slaDeadline               DateTime?
  formDataJson              Json?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime
  paymentStatus             PaymentStatus              @default(PENDING)
  servicePersonName         String?
  servicePersonNotes        String?
  servicePersonPhone        String?
  service_fee               Float                      @default(0)
  ayuxa_booking_fee         Float                      @default(0)
  delivery_fee              Float                      @default(0)
  tax_amount                Float                      @default(0)
  fee_breakdown             Json?
  caregivers                caregivers?                @relation(fields: [caregiverId], references: [id])
  cities                    cities                     @relation(fields: [cityId], references: [id])
  services                  services                   @relation(fields: [serviceId], references: [id])
  users                     users                      @relation(fields: [userId], references: [id])
  lab_orders                lab_orders[]
  medical_tourism_enquiries medical_tourism_enquiries?
  payments                  payments[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model caregivers {
  id                 String                @id
  name               String
  phone              String                @unique
  email              String?
  specialization     String?
  qualification      String?
  profileImageUrl    String?
  documentsJson      Json?
  cityId             String
  policeVerification CaregiverVerification @default(PENDING)
  isAvailable        Boolean               @default(true)
  shiftType          CaregiverShift        @default(FLEXIBLE)
  performanceRating  Float                 @default(0)
  totalBookings      Int                   @default(0)
  salary             Float                 @default(0)
  payoutNotes        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime
  bookings           bookings[]
  cities             cities                @relation(fields: [cityId], references: [id])
  sos_alerts         sos_alerts[]

  @@index([name, phone, specialization, policeVerification, isAvailable])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
